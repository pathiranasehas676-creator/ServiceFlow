// ServiceFlow Production Database Schema
// PostgreSQL + Prisma ORM
// Author: Backend Architecture Team
// Last Updated: 2026-02-12

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================
// ENUMS
// ============================================

enum UserRole {
  USER
  WORKER
  STAFF
  ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  BLACKLISTED
}

enum VerificationStatus {
  NOT_SUBMITTED
  PENDING
  APPROVED
  REJECTED
}

enum JobPaymentType {
  FIXED
  HOURLY
}

enum JobPriority {
  NORMAL
  HIGH
  URGENT
  LOW
}

enum ProofPolicyType {
  REQUIRED
  OPTIONAL
  NONE
}

enum JobPostMode {
  PUBLIC
  PRIVATE
  DIRECT_ASSIGN
}

enum JobStatus {
  POSTED
  ACCEPTED
  ARRIVED
  PROOF_SUBMITTED
  APPROVED
  COMPLETED
  REJECTED
  CANCELLED
  PENDING_PAYMENT
  PENDING_CUSTOMER_CONFIRMATION
}

enum JobCancelReason {
  WORKER_NO_SHOW
  CLIENT_CANCELLED
  WORKER_CANCELLED
  ADMIN_CANCELLED
  OTHER
  NO_SHOW // Alias for WORKER_NO_SHOW or distinct? Treating as distinct based on usage
}

enum DisputeStatus {
  OPEN
  IN_REVIEW
  RESOLVED
  CLOSED
  REJECTED
}

enum DisputeResolution {
  REFUND
  RELEASE_PAYMENT
  SPLIT
}

enum ProofType {
  GENERAL
  BEFORE
  AFTER
  GPS
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  APPROVE
  REJECT
  LOGIN
  LOGOUT
  EXPORT
  LOCKOUT
  REFRESH_REUSE
  PASSWORD_RESET_REQUESTED
  PASSWORD_RESET_COMPLETED
  RE_AUTH_SUCCESS
  RE_AUTH_FAIL
  REGISTER
  EMAIL_VERIFIED
  VERIFICATION_APPROVED
  VERIFICATION_REJECTED
  RISK_FLAGGED
  JOB_CREATE
  JOB_UPDATE
  JOB_DELETE
  JOB_CANCEL
  DISPUTE_OPEN
  DISPUTE_RESOLVE
  STAFF_PERMISSIONS_UPDATE
  PERMISSION_OVERRIDE_UPDATE
  USER_SUSPEND
  USER_UNSUSPEND
  USER_BLACKLIST
  BANK_UPDATE
  INVITE_SENT
  REQUEST_ACCESS
}

enum TransactionType {
  EARNING
  PAYOUT
  ADJUSTMENT
  DEPOSIT
  CREDIT
  DEBIT
  JOB_CREDIT
  
  // Restored
  REFUND
  HOLD
  RELEASE
  JOB_DEBIT
  FEE_CHARGE
  FEE_REFUND
  LATE_CANCEL_FEE
}

enum PayoutStatus {
  PENDING
  APPROVED
  PAID
  REJECTED
  PROCESSING
  FAILED // Restored
}



enum TicketPriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
  URGENT // Restored
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum NotificationType {
  INFO
  WARNING
  ERROR
  SUCCESS
  JOB_ASSIGNED
  JOB_UPDATE
  JOB_CANCELLED
  PROOF_DECISION
  PAYOUT_UPDATE
  VERIFICATION_UPDATE
  DISPUTE_OPENED
  TICKET_UPDATE
  
  // Added from Errors
  NEW_JOB_POSTED
  PAYOUT_STATUS
  DISPUTE_RESOLVED
  PASSWORD_CHANGED
  SESSION_REVOKED
  COMMENT_REPLY
  DISPUTE_MESSAGE
  
  // Restored
  ADMIN_ALERT_SECURITY
  VERIFICATION_STATUS
}

enum PermissionOverrideMode {
  GRANT
  DENY
  REVOKE // Restored
}

enum FilePurpose {
  ID_FRONT
  ID_BACK
  ID_SELFIE
  ID_LIVENESS
  JOB_PROOF
  PAYOUT_RECEIPT
  PROFILE_PHOTO
  DISPUTE_ATTACHMENT
  OTHER
}

enum RegistrationStatus {
  PENDING
  APPROVED
  REJECTED
}

enum InviteDeliveryMethod {
  WHATSAPP
  EMAIL
}

model User {
  id                  String    @id @default(uuid()) @db.Uuid
  email               String    @unique @db.VarChar(255)
  phoneNumber         String?   @unique @db.VarChar(20)
  passwordHash        String    @db.VarChar(255)
  fullName            String    @db.VarChar(255)
  role                UserRole  @default(USER)
  status              UserStatus @default(ACTIVE)
  
  // Security
  isTwoFactorEnabled  Boolean   @default(false)
  failedLoginAttempts Int       @default(0)
  lockoutUntil        DateTime?
  
  // Soft delete
  isActive            Boolean   @default(true)
  deletedAt           DateTime?
  deletedById         String?   @db.Uuid
  deleteReason        String?   @db.Text
  
  // Timestamps
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  
  // Relations
  sessions            UserSession[]
  twoFactorChallenges TwoFactorChallenge[]
  passwordResetTokens PasswordResetToken[]
  workerProfile       WorkerProfile?
  wallet              Wallet?
  notifications       Notification[]
  auditLogs           AdminAuditLog[]
  createdJobs         Job[]            @relation("JobCreator")
  ratingsGiven        Rating[]         @relation("RatingGiver")
  ratingsReceived     Rating[]         @relation("RatingReceiver")
  createdTickets      SupportTicket[]  @relation("TicketCreator")
  ticketMessages      TicketMessage[]
  jobComments         JobComment[]
  uploadedFiles       FileObject[]
  emailVerifiedAt     DateTime?
  verificationTokens  VerificationToken[]
  securityAlerts      SecurityAlert[]
  permissions         UserPermission[]
  
  // KYC & Risk
  verificationLevel   Int       @default(0) // 0=None, 1=Email, 2=Identity, 3=Bank
  verificationScore   Int       @default(0) // 0-100 Risk Score
  riskFlags           Json?     // e.g. ["SHARED_DEVICE", "MULTIPLE_FAILED_LOGINS"]

  // Relations
  verificationHistory VerificationHistory[]

  // Payment Administration
  approvedJobPayments JobPayment[]     @relation("PaymentApprover")
  paidJobPayments     JobPayment[]     @relation("PaymentPayer")
  apiRequestLogs      ApiRequestLog[]
  errorLogs           ErrorLog[]

  openedDisputes      Dispute[]        @relation("DisputeOpener")
  reviewedDisputes    Dispute[]        @relation("DisputeReviewer")
  disputeMessages     DisputeMessage[]
  
  // Financial
  paymentSessions     PaymentSession[]
  stripeCustomerId    String?          @db.VarChar(255)
  
  bankDetailsChanges  BankDetailsHistory[] @relation("BankHistoryActor")
  
  // Registration & Invites
  reviewedRequests    RegistrationRequest[] @relation("RequestReviewer")
  createdInvites      InviteToken[]         @relation("InviteCreator")

  @@index([email])
  @@index([role, isActive])
  @@index([status])
  @@index([verificationLevel])
  @@index([verificationScore])
  @@map("users")
}

model ErrorLog {
  id          String   @id @default(uuid()) @db.Uuid
  severity    String   @default("high") @db.VarChar(20) // low, medium, high, critical
  source      String   @default("backend") @db.VarChar(50)
  message     String   @db.Text
  stack       String?  @db.Text
  path        String?  @db.VarChar(500)
  method      String?  @db.VarChar(10)
  
  userId      String?  @db.Uuid
  user        User?    @relation(fields: [userId], references: [id])
  
  ipAddress   String?  @db.VarChar(45)
  userAgent   String?  @db.Text
  safePayload Json?
  
  createdAt   DateTime @default(now())
  
  @@index([severity, createdAt])
  @@index([source])
  @@index([userId])
  @@map("error_logs")
}

model UserSession {
  id               String    @id @default(uuid()) @db.Uuid
  userId           String    @db.Uuid
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshTokenHash String    @unique
  ipAddress        String?
  userAgent        String?
  expiresAt        DateTime
  revokedAt        DateTime?
  rotatedToId      String?
  lastUsedAt       DateTime?
  createdAt        DateTime  @default(now())

  @@index([userId])
  @@map("user_sessions")
}

model TwoFactorChallenge {
  id            String    @id @default(uuid()) @db.Uuid
  userId        String    @db.Uuid
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  otpHash       String
  expiresAt     DateTime
  consumedAt    DateTime?
  attemptsCount Int       @default(0)
  createdAt     DateTime  @default(now())

  @@index([userId])
  @@map("two_factor_challenges")
}

model PasswordResetToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  ipAddress String?
  userAgent String?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@map("password_reset_tokens")
}

model VerificationToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@map("verification_tokens")
}

model LoginAttempt {
  id          String   @id @default(uuid()) @db.Uuid
  email       String
  ipAddress   String
  success     Boolean
  attemptedAt DateTime @default(now())

  @@index([email])
  @@index([ipAddress])
  @@map("login_attempts")
}

model VerificationHistory {
  id          String    @id @default(uuid()) @db.Uuid
  userId      String    @db.Uuid
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  action      String    @db.VarChar(50) // SUBMITTED, APPROVED, REJECTED, REQUEST_CHANGES
  type        String    @db.VarChar(50) // IDENTITY, BANK, PROFILE
  
  previousStatus String? @db.VarChar(50)
  newStatus      String? @db.VarChar(50)
  
  reason      String?   @db.Text
  adminId     String?   @db.Uuid // If action performed by admin
  
  createdAt   DateTime  @default(now())
  
  @@index([userId])
  @@index([createdAt])
  @@map("verification_history")
}

// ... (Rest of existing schema down to BankDetails)

model BankDetails {
  id                String        @id @default(uuid()) @db.Uuid
  workerProfileId   String        @unique @db.Uuid
  workerProfile     WorkerProfile @relation(fields: [workerProfileId], references: [id], onDelete: Cascade)
  
  // Bank info (encrypted at application layer)
  bankName          String        @db.VarChar(255)
  
  // Encrypted account number (AES-256-GCM)
  encryptedAccountNumber String    @db.Text
  accountNumberIV        String    @db.VarChar(255)
  accountNumberAuthTag   String?   @db.VarChar(255) // Mandator for GCM
  accountNumberLast4     String    @db.VarChar(4)
  encryptionVersion      Int       @default(1)
  
  // Duplicate Detection (Deterministic Hash of Account Number)
  accountNumberHash      String?   @unique @db.VarChar(255)
  
  accountName       String        @db.VarChar(255)
  branchCode        String?       @db.VarChar(50)
  swiftCode         String?       @db.VarChar(50)
  
  // Verification
  isVerified        Boolean       @default(false)
  verifiedAt            DateTime?
  hmacSignature         String?        @db.Text
  bankVerifiedAt    DateTime?     // Explicit KYC verification timestamp
  
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  
  // Soft delete
  deletedAt       DateTime?
  deletedById     String?   @db.Uuid
  deleteReason    String?   @db.Text
  
  history         BankDetailsHistory[]
  
  @@index([workerProfileId])
  @@map("bank_details")
}

model BankDetailsHistory {
  id                String       @id @default(uuid()) @db.Uuid
  bankDetailsId     String       @db.Uuid
  bankDetails       BankDetails  @relation(fields: [bankDetailsId], references: [id], onDelete: Cascade)
  
  // Snapshot of keys that changed
  accountNumberHash String?      @db.VarChar(255)
  accountName       String?      @db.VarChar(255)
  bankName          String?      @db.VarChar(255)
  
  changedById       String?      @db.Uuid
  changedBy         User?        @relation("BankHistoryActor", fields: [changedById], references: [id])
  reason            String?      @db.Text
  
  createdAt         DateTime     @default(now())
  
  @@index([bankDetailsId])
  @@map("bank_details_history")
}

model IdVerification {
  id                String             @id @default(uuid()) @db.Uuid
  workerProfileId   String             @db.Uuid
  workerProfile     WorkerProfile      @relation(fields: [workerProfileId], references: [id], onDelete: Cascade)
  
  // Document details
  documentType      String             @db.VarChar(50) // e.g., "NATIONAL_ID", "PASSPORT"
  documentNumber    String?            @db.VarChar(100)
  
  // S3 storage keys
  frontImageKey     String             @db.VarChar(500)
  backImageKey      String?            @db.VarChar(500)
  selfieKey         String?            @db.VarChar(500)
  livenessKey       String?            @db.VarChar(500)
  
  // File metadata
  frontImageSize    Int?
  backImageSize     Int?
  selfieSize        Int?
  livenessSize      Int?
  
  // Status
  status            VerificationStatus @default(PENDING)
  reviewedBy        String?            @db.Uuid
  reviewedAt        DateTime?
  rejectionReason   String?            @db.Text
  adminNotes        String?            @db.Text
  
  submittedAt       DateTime           @default(now())
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  fileObjects       FileObject[]
  
  @@index([workerProfileId])
  @@index([status, submittedAt])
  @@map("id_verifications")
}

// ============================================
// SERVICES & JOBS
// ============================================

model Service {
  id          String    @id @default(uuid()) @db.Uuid
  name        String    @unique @db.VarChar(255)
  description String?   @db.Text
  category    String?   @db.VarChar(100)
  
  // Pricing (in cents)
  basePriceCents Int?
  
  isActive    Boolean   @default(true)
  deletedAt   DateTime?
  deletedById String?   @db.Uuid
  deleteReason String?  @db.Text
  
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  
  // Relations
  jobs        Job[]
  
  @@index([isActive])
  @@index([category])
  @@map("services")
}

model Job {
  id              String    @id @default(uuid()) @db.Uuid
  
  // Job details
  title           String    @db.VarChar(500)
  description     String    @db.Text
  notes           String?   @db.Text
  serviceId       String    @db.Uuid
  service         Service   @relation(fields: [serviceId], references: [id])
  
  // Advanced Pricing
  paymentType     JobPaymentType @default(FIXED)
  priceCents      Int            // worker payout for FIXED OR hourlyRateCents for HOURLY
  hourlyRateCents Int?
  estimatedHours  Int?
  maxHours        Int?           // Optional cap
  platformFeeCents Int           @default(0)
  totalCostCents  Int            @default(0) // payout + platformFee
  priority        JobPriority    @default(NORMAL)

  // Schedule
  executionDate   DateTime       // Using this for date
  timeSlot        String?        @db.VarChar(100)
  mustFinishBy    DateTime?      // Optional SLA
  
  // Arrival / Geo Settings
  requireArrival       Boolean   @default(true)
  geofenceRadiusM      Int       @default(150)
  arrivalWindowMinutes Int       @default(30)
  locationLat          Decimal   @db.Decimal(10, 8)
  locationLng          Decimal   @db.Decimal(11, 8)
  address              String    @db.Text
  district             String?   @db.VarChar(100)
  
  // Proof Policy
  proofPolicy        ProofPolicyType @default(REQUIRED)
  minProofImages     Int             @default(1)
  requireBeforeAfter Boolean         @default(false)
  requireGpsPhoto    Boolean         @default(false)

  // Eligibility Filters
  verifiedOnly       Boolean   @default(false)
  minWorkerRating    Float?
  districtRestricted Boolean   @default(true)

  // Posting Controls
  postMode           JobPostMode @default(PUBLIC)
  directAssignWorkerId String?   @db.Uuid
  notifyWorkers      Boolean     @default(false)

  // Cancellation Policy
  cancelAllowed      Boolean   @default(true)
  cancelBeforeHours  Int       @default(2)
  lateCancelFeeCents Int       @default(0)

  // Status
  status          JobStatus @default(POSTED)
  
  // Assignment
  createdBy       String    @db.Uuid
  creator         User      @relation("JobCreator", fields: [createdBy], references: [id], onDelete: Cascade)
  
  workerId        String?   @db.Uuid
  worker          WorkerProfile? @relation("WorkerJobs", fields: [workerId], references: [id])
  
  assignedAt      DateTime?
  acceptedAt      DateTime?
  arrivedAt       DateTime?
  completedAt     DateTime?
  cancelledAt     DateTime?
  cancelledById   String?         @db.Uuid
  cancelReason    JobCancelReason?
  cancelNote      String?         @db.Text
  cancelledFeeCents Int           @default(0)
  disputeWindowDays Int           @default(7)
  
  // Auto-assignment tracking
  autoAssigned     Boolean   @default(false)
  assignmentScore  Decimal?  @db.Decimal(5, 4)
  assignmentReason Json?
  
  // Arrival tracking
  arrivedLatitude       Float?
  arrivedLongitude      Float?
  arrivalDistanceMeters Int?
  arrivalIp             String?   @db.VarChar(45)
  arrivalUserAgent      String?   @db.Text
  arrivalAccuracyMeters Int?
  arrivalIsMock         Boolean   @default(false)

  // Proof & rejection
  rejectionReason String?   @db.Text
  resubmitDeadline DateTime?
  
  // Soft delete
  deletedAt       DateTime?
  deletedById     String?   @db.Uuid
  deleteReason    String?   @db.Text
  
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  
  // Relations
  statusHistory   JobStatusHistory[]
  proofs          JobProof[]
  attachments     JobAttachment[]
  fileObjects     FileObject[]
  rating          Rating?
  payment         JobPayment?
  paymentSession  PaymentSession?
  comments        JobComment[]
  disputes        Dispute[]
  
  @@index([status, createdAt])
  @@index([postMode, status])
  @@index([serviceId, status])
  @@index([workerId, status])
  @@index([district, status])
  @@index([createdBy])
  @@index([executionDate])
  @@map("jobs")
}

model Dispute {
  id                String            @id @default(uuid()) @db.Uuid
  jobId             String            @db.Uuid
  job               Job               @relation(fields: [jobId], references: [id], onDelete: Cascade)
  
  openedById        String            @db.Uuid
  openedBy          User              @relation("DisputeOpener", fields: [openedById], references: [id])
  
  status            DisputeStatus     @default(OPEN)
  reason            String            @db.Text
  
  resolution        DisputeResolution?
  resolutionNote    String?           @db.Text
  
  reviewedById      String?           @db.Uuid
  reviewedBy        User?             @relation("DisputeReviewer", fields: [reviewedById], references: [id])
  
  resolutionTransactionId String?     @db.Uuid // For idempotency
  
  resolvedAt        DateTime?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  
  messages          DisputeMessage[]
  attachments       DisputeAttachment[]
  
  @@index([status, createdAt])
  @@index([jobId])
  @@map("disputes")
}

model DisputeMessage {
  id                String            @id @default(uuid()) @db.Uuid
  disputeId         String            @db.Uuid
  dispute           Dispute           @relation(fields: [disputeId], references: [id], onDelete: Cascade)
  
  senderId          String            @db.Uuid
  sender            User              @relation(fields: [senderId], references: [id])
  
  message           String            @db.Text
  createdAt         DateTime          @default(now())
  
  @@index([disputeId, createdAt])
  @@map("dispute_messages")
}

model DisputeAttachment {
  id                String            @id @default(uuid()) @db.Uuid
  disputeId         String            @db.Uuid
  dispute           Dispute           @relation(fields: [disputeId], references: [id], onDelete: Cascade)
  
  fileKey           String            @db.VarChar(500)
  mimeType          String            @db.VarChar(100)
  size              Int
  originalName      String            @db.VarChar(255)
  
  createdAt         DateTime          @default(now())
  
  @@index([disputeId])
  @@map("dispute_attachments")
}

model JobAttachment {
  id           String    @id @default(uuid()) @db.Uuid
  jobId        String    @db.Uuid
  job          Job       @relation(fields: [jobId], references: [id], onDelete: Cascade)
  
  fileKey      String    @db.VarChar(500)
  mimeType     String    @db.VarChar(100)
  size         Int
  originalName String    @db.VarChar(255)
  
  createdAt    DateTime  @default(now())

  @@index([jobId])
  @@map("job_attachments")
}

model JobStatusHistory {
  id          String    @id @default(uuid()) @db.Uuid
  jobId       String    @db.Uuid
  job         Job       @relation(fields: [jobId], references: [id], onDelete: Cascade)
  
  fromStatus  JobStatus?
  toStatus    JobStatus
  
  changedBy   String?   @db.Uuid
  reason      String?   @db.Text
  metadata    Json?
  
  createdAt   DateTime  @default(now())
  
  @@index([jobId, createdAt])
  @@map("job_status_history")
}

model JobProof {
  id            String    @id @default(uuid()) @db.Uuid
  jobId         String    @db.Uuid
  job           Job       @relation(fields: [jobId], references: [id], onDelete: Cascade)
  
  // S3 storage
  imageKey      String    @db.VarChar(500)
  imageUrl      String?   @db.VarChar(1000)
  mimeType      String    @db.VarChar(100)
  fileSizeBytes Int
  
  proofType     ProofType @default(GENERAL)
  
  // Metadata
  caption       String?   @db.Text
  sequenceOrder Int       @default(0)
  
  uploadedAt    DateTime  @default(now())
  
  @@index([jobId, sequenceOrder])
  @@map("job_proofs")
}

model Rating {
  id          String   @id @default(uuid()) @db.Uuid
  jobId       String   @unique @db.Uuid
  job         Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  
  // Who rated whom
  giverId     String   @db.Uuid
  giver       User     @relation("RatingGiver", fields: [giverId], references: [id])
  
  receiverId  String   @db.Uuid
  receiver    User     @relation("RatingReceiver", fields: [receiverId], references: [id])
  
  // Rating
  score       Int      // 1-5
  comment     String?  @db.Text
  
  workerId    String   @db.Uuid
  worker      WorkerProfile @relation("WorkerRatings", fields: [workerId], references: [id])

  createdAt   DateTime @default(now())
  
  @@index([receiverId])
  @@index([workerId])
  @@index([createdAt])
  @@map("ratings")
}

model JobComment {
  id        String   @id @default(uuid()) @db.Uuid
  jobId     String   @db.Uuid
  job       Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  
  senderId  String   @db.Uuid
  sender    User     @relation(fields: [senderId], references: [id])
  
  message   String   @db.Text
  createdAt DateTime @default(now())
  
  @@index([jobId, createdAt])
  @@map("job_comments")
}

model WorkerPerformance {
  id                 String        @id @default(uuid()) @db.Uuid
  workerId           String        @unique @db.Uuid
  worker             WorkerProfile @relation(fields: [workerId], references: [id], onDelete: Cascade)
  
  totalJobs          Int           @default(0)
  onTimeArrivals     Int           @default(0)
  avgArrivalDelayMinutes Float     @default(0)

  cancellationCount  Int           @default(0)
  noShowCount        Int           @default(0)
  reliabilityScore   Float         @default(100.0)
  
  updatedAt          DateTime      @updatedAt
  
  @@map("worker_performance")
}

// ============================================
// WALLET & TRANSACTIONS
// ============================================

model Wallet {
  id                  String           @id @default(uuid()) @db.Uuid
  userId              String           @unique @db.Uuid
  user                User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  // Balances (in cents)
  availableBalanceCents Int            @default(0)
  pendingBalanceCents   Int            @default(0)
  totalEarnedCents      Int            @default(0)
  hmacSignature         String?        @db.Text
  
  // Metadata
  currency            String           @default("USD") @db.VarChar(3)
  
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt
  
  // Relations
  transactions        Transaction[]
  payoutRequests      PayoutRequest[]
  
  @@index([userId])
  @@map("wallets")
}

enum TransactionStatus {
  PENDING
  COMPLETED
  REVERSED
  FAILED
}

model Transaction {
  id              String          @id @default(uuid()) @db.Uuid
  walletId        String          @db.Uuid
  wallet          Wallet          @relation(fields: [walletId], references: [id], onDelete: Cascade)
  
  // Transaction details
  type            TransactionType
  amountCents     Int
  status          TransactionStatus @default(COMPLETED)
  
  // Reference
  referenceType   String?         @db.VarChar(50) 
  referenceId     String?         @db.Uuid
  
  description     String          @db.Text
  metadata        Json?
  hmacSignature   String?         @db.Text
  
  idempotencyKey  String          @unique @db.VarChar(255)
  
  // Balance snapshot
  balanceAfterCents Int
  
  completedAt     DateTime?
  createdAt       DateTime        @default(now())
  
  @@index([walletId, createdAt])
  @@index([referenceType, referenceId])
  @@map("transactions")
}

model PayoutRequest {
  id              String        @id @default(uuid()) @db.Uuid
  walletId        String        @db.Uuid
  wallet          Wallet        @relation(fields: [walletId], references: [id], onDelete: Cascade)
  
  // Amount (in cents)
  amountCents     Int
  
  // Status
  status          PayoutStatus  @default(PENDING)
  type            PayoutType    @default(WEEKLY)
  
  idempotencyKey  String        @unique @db.VarChar(255)
  
  // Admin review
  reviewedBy      String?       @db.Uuid
  reviewedAt      DateTime?
  rejectionReason String?       @db.Text
  adminNote       String?       @db.Text
  
  // Processing
  transactionRef  String?       @db.VarChar(255)
  paymentReference String?      @db.VarChar(255)
  processedAt     DateTime?
  paidAt          DateTime?
  
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  
  // Relations
  receipt         PayoutReceipt?
  statusHistory   PayoutStatusHistory[]
  
  @@index([walletId, status])
  @@index([status, createdAt])
  @@index([type, createdAt])
  // Soft delete
  deletedAt       DateTime?
  deletedById     String?   @db.Uuid
  deleteReason    String?   @db.Text
  
  @@map("payout_requests")
}

model PayoutReceipt {
  id              String        @id @default(uuid()) @db.Uuid
  payoutRequestId String        @unique @db.Uuid
  payoutRequest   PayoutRequest @relation(fields: [payoutRequestId], references: [id], onDelete: Cascade)
  
  // S3 storage
  receiptKey      String        @db.VarChar(500)
  receiptUrl      String?       @db.VarChar(1000)
  mimeType        String        @db.VarChar(100)
  fileSizeBytes   Int
  
  uploadedBy      String        @db.Uuid
  uploadedAt      DateTime      @default(now())
  fileObjects     FileObject[]
  
  @@index([payoutRequestId])
  @@map("payout_receipts")
}

model PaymentSession {
  id                String   @id @default(uuid()) @db.Uuid
  jobId             String   @unique @db.Uuid
  job               Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  
  userId            String   @db.Uuid
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  stripeSessionId   String   @unique @db.VarChar(255)
  paymentIntentId   String?  @unique @db.VarChar(255)
  amountCents       Int
  currency          String   @default("USD") @db.VarChar(3)
  
  status            String   @db.VarChar(50) // PENDING, COMPLETE, EXPIRED, FAILED
  
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([userId])
  @@index([stripeSessionId])
  @@map("payment_sessions")
}

model StripeAccount {
  id                String   @id @default(uuid()) @db.Uuid
  workerProfileId   String   @unique @db.Uuid
  workerProfile     WorkerProfile @relation(fields: [workerProfileId], references: [id], onDelete: Cascade)
  
  stripeAccountId   String   @unique @db.VarChar(255)
  detailsSubmitted  Boolean  @default(false)
  payoutsEnabled    Boolean  @default(false)
  
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@map("stripe_accounts")
}

model PayoutStatusHistory {
  id              String        @id @default(uuid()) @db.Uuid
  payoutRequestId String        @db.Uuid
  payoutRequest   PayoutRequest @relation(fields: [payoutRequestId], references: [id], onDelete: Cascade)
  
  fromStatus      PayoutStatus?
  toStatus        PayoutStatus
  
  actorId         String        @db.Uuid
  reason          String?       @db.Text
  
  createdAt       DateTime      @default(now())
  
  @@index([payoutRequestId])
  @@map("payout_status_history")
}

// ============================================
// SUPPORT & NOTIFICATIONS
// ============================================

model SupportTicket {
  id          String         @id @default(uuid()) @db.Uuid
  ticketNumber String        @unique @db.VarChar(50)
  
  createdBy   String         @db.Uuid
  creator     User           @relation("TicketCreator", fields: [createdBy], references: [id])
  
  subject     String         @db.VarChar(500)
  description String?        @db.Text
  category    String?        @db.VarChar(100)
  priority    TicketPriority @default(MEDIUM)
  status      TicketStatus   @default(OPEN)
  
  assignedTo  String?        @db.Uuid
  
  resolvedAt  DateTime?
  closedAt    DateTime?

  // Soft delete
  deletedAt       DateTime?
  deletedById     String?   @db.Uuid
  deleteReason    String?   @db.Text
  
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  
  // Relations
  messages    TicketMessage[]
  
  @@index([createdBy])
  @@index([status, createdAt])
  @@index([assignedTo])
  @@map("support_tickets")
}

model TicketMessage {
  id        String        @id @default(uuid()) @db.Uuid
  ticketId  String        @db.Uuid
  ticket    SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  
  senderId  String        @db.Uuid
  sender    User          @relation(fields: [senderId], references: [id])
  
  content   String        @db.Text
  
  // Attachments (S3 keys)
  attachments String[]    @default([])
  
  isInternal Boolean      @default(false)
  
  createdAt DateTime     @default(now())
  
  @@index([ticketId, createdAt])
  @@map("ticket_messages")
}

model Notification {
  id           String           @id @default(uuid()) @db.Uuid
  userId       String           @db.Uuid
  user         User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  type         NotificationType
  title        String           @db.VarChar(255)
  message      String           @db.Text
  
  entityType   String?          @db.VarChar(50) // JOB, PAYOUT, TICKET
  entityId     String?          @db.Uuid
  
  metadata     Json?
  
  isRead       Boolean          @default(false)
  readAt       DateTime?
  createdAt    DateTime         @default(now())
  
  @@index([userId])
  @@index([createdAt])
  @@map("notifications")
}

// ============================================
// AUDIT LOGS (APPEND-ONLY, IMMUTABLE)
// ============================================

model AdminAuditLog {
  id          String      @id @default(uuid()) @db.Uuid
  
  // Actor
  actorId     String?     @db.Uuid
  actor       User?       @relation(fields: [actorId], references: [id], onDelete: Cascade)
  actorEmail  String?     @db.VarChar(255) // Denormalized for history
  
  // Action
  action      AuditAction
  actionDetail String?    @db.VarChar(255)
  
  // Entity
  entityType  String      @db.VarChar(100)
  entityId    String?     @db.Uuid
  
  // Changes (JSON)
  oldValue    Json?
  newValue    Json?
  
  // Context
  ipAddress   String?     @db.VarChar(45)
  userAgent   String?     @db.Text
  
  // Immutable timestamp
  createdAt   DateTime    @default(now())
  
  @@index([actorId, createdAt])
  @@index([entityType, entityId])
  @@index([action, createdAt])
  @@index([createdAt])
  @@map("admin_audit_logs")
}

// ============================================
// SYSTEM CONFIGURATION (OPTIONAL)
// ============================================

model SystemConfig {
  id    String @id @default(uuid()) @db.Uuid
  key   String @unique @db.VarChar(100)
  value Json
  
  description String?  @db.Text
  
  updatedBy   String?  @db.Uuid
  updatedAt   DateTime @updatedAt
  createdAt   DateTime @default(now())
  
  @@map("system_config")
}

model SecurityAlert {
  id          String   @id @default(uuid()) @db.Uuid
  type        String   @db.VarChar(100)
  severity    String   @db.VarChar(20) // LOW, MEDIUM, HIGH, CRITICAL
  title       String   @db.VarChar(255)
  description String   @db.Text
  
  // Context
  userId      String?  @db.Uuid
  user        User?    @relation(fields: [userId], references: [id])
  metadata    Json?    // IP, UserAgent, relevant entity IDs
  
  isResolved  Boolean  @default(false)
  resolvedAt  DateTime?
  resolvedBy  String?  @db.Uuid
  
  createdAt   DateTime @default(now())
  
  @@index([type])
  @@index([severity])
  @@index([isResolved])
  @@map("security_alerts")
}

model Permission {
  id          String   @id @default(uuid()) @db.Uuid
  code        String   @unique @db.VarChar(100) // key e.g. "CREATE_JOBS"
  name        String   @db.VarChar(100)        // Human label
  group       String   @db.VarChar(50)         // Category: e.g. "Jobs", "Finance"
  description String?  @db.Text
  createdAt   DateTime @default(now())
  
  roles     RolePermission[]
  users     UserPermission[]
  
  @@map("permissions")
}

model UserPermission {
  id           String     @id @default(uuid()) @db.Uuid
  userId       String     @db.Uuid
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  permissionId String     @db.Uuid
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  
  mode         PermissionOverrideMode @default(GRANT)
  
  createdAt    DateTime   @default(now())
  
  @@unique([userId, permissionId])
  @@map("user_permissions")
}

enum JobPaymentStatus {
  PENDING
  PAID
  VOID
  ON_HOLD
}

enum PayoutType {
  WEEKLY
  SPECIAL
}

model JobPayment {
  id              String   @id @default(uuid()) @db.Uuid
  jobId           String   @unique @db.Uuid
  job             Job      @relation(fields: [jobId], references: [id])
  workerId        String   @db.Uuid
  worker          WorkerProfile @relation(fields: [workerId], references: [id])
  
  amountCents     Int
  status          JobPaymentStatus @default(PENDING)
  
  approvedById    String?   @db.Uuid
  approvedBy      User?     @relation("PaymentApprover", fields: [approvedById], references: [id])
  approvedAt      DateTime?
  
  paidById        String?   @db.Uuid
  paidBy          User?     @relation("PaymentPayer", fields: [paidById], references: [id])
  paidAt          DateTime?
  
  holdReason      String?   @db.Text
  idempotencyKey  String    @unique @db.VarChar(255)
  
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  
  @@index([workerId, createdAt])
  @@index([status, createdAt])
  @@map("job_payments")
}

model RolePermission {
  id           String     @id @default(uuid()) @db.Uuid
  role         UserRole
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  permissionId String     @db.Uuid
  
  @@unique([role, permissionId])
  @@map("role_permissions")
}

model WorkerProfile {
  id                String    @id @default(uuid()) @db.Uuid
  userId            String    @unique @db.Uuid
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  fullName          String?   @db.VarChar(255)
  nicNumber         String?   @db.VarChar(50)
  documentType      String?   @db.VarChar(50) // e.g., "NATIONAL_ID", "PASSPORT"
  address           String?   @db.Text
  bio               String?   @db.Text
  skills            Json?
  hourlyRateCents   Int?
  profilePhotoFileKey String? @db.VarChar(500)
  
  verificationStatus VerificationStatus @default(NOT_SUBMITTED)
  profileCompleted   Boolean            @default(false)
  completionScore    Int                @default(0) // 0-100
  missingProfileItems Json?
  lastComputedAt     DateTime?
  isOnline           Boolean            @default(false)

  isSuspended        Boolean            @default(false)
  suspendedAt        DateTime?
  suspensionReason   String?            @db.Text
  
  // Soft delete
  deletedAt       DateTime?
  deletedById     String?   @db.Uuid
  deleteReason    String?   @db.Text
  
  // Relations
  bankDetails       BankDetails?
  idVerifications   IdVerification[]
  jobs              Job[]            @relation("WorkerJobs")
  ratings           Rating[]         @relation("WorkerRatings")
  performance       WorkerPerformance?
  jobPayments       JobPayment[]
  stripeAccount     StripeAccount?

  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  
  @@map("worker_profiles")
}

model RegistrationRequest {
  id           String             @id @default(uuid()) @db.Uuid
  fullName     String             @db.VarChar(255)
  email        String             @db.VarChar(255) // normalized lowercase in app logic, but stored here
  phone        String             @db.VarChar(20)
  nic          String?            @db.VarChar(50)
  status       RegistrationStatus @default(PENDING)
  
  reviewedById String?            @db.Uuid
  reviewedBy   User?              @relation("RequestReviewer", fields: [reviewedById], references: [id])
  reviewedAt   DateTime?
  reviewReason String?            @db.Text
  
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  inviteToken  InviteToken?

  @@index([status, createdAt])
  @@index([email])
  @@index([phone])
  @@map("registration_requests")
}

model InviteToken {
  id             String              @id @default(uuid()) @db.Uuid
  requestId      String              @unique @db.Uuid
  request        RegistrationRequest @relation(fields: [requestId], references: [id])
  
  email          String              @db.VarChar(255)
  phone          String              @db.VarChar(20)
  
  tokenHash      String              @db.VarChar(255)
  expiresAt      DateTime
  usedAt         DateTime?
  
  deliveryMethod InviteDeliveryMethod
  sentAt         DateTime?
  
  createdById    String              @db.Uuid
  createdBy      User                @relation("InviteCreator", fields: [createdById], references: [id])
  
  createdAt      DateTime            @default(now())

  @@index([requestId])
  @@index([expiresAt])
  @@index([usedAt])
  @@index([deliveryMethod])
  @@map("invite_tokens")
}

model FileObject {
  id          String   @id @default(uuid()) @db.Uuid
  purpose     FilePurpose
  
  // S3
  key         String   @db.VarChar(500)
  url         String   @db.VarChar(1000)
  mimeType    String   @db.VarChar(100)
  sizeBytes   Int
  
  // Ownership
  uploadedBy  String   @db.Uuid
  uploader    User     @relation(fields: [uploadedBy], references: [id])
  
  // Contexts
  jobId       String?  @db.Uuid
  job         Job?     @relation(fields: [jobId], references: [id])
  
  verificationId String? @db.Uuid
  verification   IdVerification? @relation(fields: [verificationId], references: [id])

  payoutReceiptId String? @db.Uuid
  payoutReceipt   PayoutReceipt? @relation(fields: [payoutReceiptId], references: [id])
  
  createdAt   DateTime @default(now())
  
  @@index([uploadedBy])
  @@map("file_objects")
}

model ApiRequestLog {
  id          String   @id @default(uuid()) @db.Uuid
  method      String   @db.VarChar(10)
  path        String   @db.VarChar(500)
  statusCode  Int
  durationMs  Int
  
  role        String?  @db.VarChar(50)
  userId      String?  @db.Uuid
  user        User?    @relation(fields: [userId], references: [id])
  
  ipAddress   String?  @db.VarChar(45)
  userAgent   String?  @db.Text
  
  createdAt   DateTime @default(now())

  @@index([createdAt])
  @@index([path])
  @@index([statusCode])
  @@index([userId])
  @@map("api_request_logs")
}

model BlockedIp {
  id          String   @id @default(uuid()) @db.Uuid
  ipAddress   String   @unique @db.VarChar(45)
  reason      String   @db.Text
  expiresAt   DateTime?
  createdAt   DateTime @default(now())

  @@index([ipAddress])
  @@map("blocked_ips")
}
