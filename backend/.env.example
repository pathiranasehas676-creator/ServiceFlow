# Database
DATABASE_URL="postgresql://admin:password123@localhost:5432/serviceflow?schema=public"

# Security
JWT_SECRET="changeme_super_secret_access_key"
JWT_REFRESH_SECRET="changeme_super_secret_refresh_key"
COOKIE_SECRET="changeme_super_secret_cookie_key"
CORS_ORIGIN="http://localhost:3000"

# Application
PORT=3001
NODE_ENV=development

# Storage (Minio)
MINIO_ENDPOINT="localhost"
MINIO_PORT=9000
MINIO_ACCESS_KEY="admin"
MINIO_SECRET_KEY="password123"
MINIO_BUCKET_NAME="serviceflow-uploads"

# Redis
REDIS_HOST="localhost"
REDIS_PORT=6379

# Email Configuration
# Providers: mailtrap, ethereal, sendgrid, ses
EMAIL_PROVIDER=ethereal
EMAIL_FROM="ServiceFlow <noreply@serviceflow.com>"

# Mailtrap
MAILTRAP_HOST=sandbox.smtp.mailtrap.io
MAILTRAP_PORT=2525
MAILTRAP_USER=your_user
MAILTRAP_PASS=your_pass

# SendGrid
SENDGRID_API_KEY=SG.your_api_key

# Ethereal (Auto-generated if not set)
ETHEREAL_HOST=smtp.ethereal.email
ETHEREAL_PORT=587
ETHEREAL_USER=
ETHEREAL_PASS=

# Verification
REQUIRE_EMAIL_VERIFICATION=true
FRONTEND_URL=http://localhost:3000
